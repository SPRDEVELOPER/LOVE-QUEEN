# ── required ─────────────────────────────────────────────
BOT_TOKEN=
MONGODB_URI=
ADMIN_ID=            # one id, or several separated by commas: 12345,67890
BOT_USERNAME=        # without @ (optional - auto-detected if empty)

# ── optional ─────────────────────────────────────────────
DB_NAME=flames_bot
MODE=                # polling | webhook  (auto: webhook if a public URL exists)
WEBHOOK_URL=         # e.g. https://your-app.onrender.com  (Render/Railway are auto-detected)
PORT=8080
WEBHOOK_SECRET=      # optional, auto-derived from BOT_TOKEN if empty
COOLDOWN_SECONDS=8
MAX_NAME_LENGTH=30
RATE_LIMIT_MAX=8     # max actions ...
RATE_LIMIT_WINDOW=10 # ... per this many seconds
LEADERBOARD_PAGE_SIZE=10

# ── optional custom anime-girl images (comma separated direct image URLs) ──
# sections: WELCOME MENU HELP STATS LEADERBOARD LOADING PROMPT1 PROMPT2 ADMIN ERROR
#           RES_F RES_L RES_A RES_M RES_E RES_S
# IMG_WELCOME=https://example.com/a.jpg,https://example.com/b.jpg
